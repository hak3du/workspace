# Local SQLite database URL used by Prisma. Keep real credentials in .env only.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# AHE Market mode. Keep simulation until real Solana/Pump.fun transaction
# adapters have been implemented, tested on devnet, and reviewed.
AHE_MARKET_MODE=simulation

# Server-side Solana RPC endpoint. Leave unset until configured.
# Do not place wallet private keys or seed phrases here.
SOLANA_RPC_URL=

# Client-visible cluster selection is only a UI hint, not a security boundary.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
