# GitHub OAuth / NextAuth (required for real user sessions)
# Create a GitHub OAuth App with callback URL: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Generate a strong random secret; never commit the real value.
NEXTAUTH_SECRET=

# Local SQLite URL used by Prisma CLI and local development.
# This SQLite URL is for local development only. The current Prisma client
# is NOT connected to Turso; setting Turso variables below does not enable it.
DATABASE_URL=file:./dev.db

# Hosted Turso/libSQL credentials (adapter integration is still pending).
# Keep TURSO_AUTH_TOKEN secret.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Live transactions remain blocked unless BOTH flags are true and the cluster is mainnet-beta.
# Keep the verification flag false until buy/sell transaction paths have passed documented tests.
NEXT_PUBLIC_ENABLE_REAL_PUMP_TRADING=false
NEXT_PUBLIC_PUMP_TRADING_VERIFIED=false

# Production is the default. Use simulation ONLY for an explicitly labelled demo.
# The legacy simulated trade API refuses writes outside simulation mode.
AHE_MARKET_MODE=mainnet

# Optional server-side Birdeye market-data key for authenticated OHLCV chart fallback.
# Keep this secret; do not use a NEXT_PUBLIC_ prefix.
BIRDEYE_API_KEY=

# Server-side Solana RPC endpoint. Configure a reliable provider before launch.
# Do not place wallet private keys or seed phrases here.
SOLANA_RPC_URL=

# Client-visible cluster selection controls the wallet's RPC connection.
# Use devnet for devnet test assets; use mainnet-beta for real Pump.fun assets.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
