# Local SQLite URL used by Prisma CLI and local development.
# In Vercel, keep this as file:./dev.db for Prisma schema generation; the app
# uses TURSO_DATABASE_URL + TURSO_AUTH_TOKEN for its remote runtime connection.
DATABASE_URL=file:./dev.db

# Hosted Turso/libSQL database. Keep TURSO_AUTH_TOKEN secret.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Keep marketplace transactions simulated until wallet signing, fee sharing,
# on-chain submission, confirmation, and settlement have been implemented and tested.
AHE_MARKET_MODE=simulation

# Server-side Solana RPC endpoint. Leave unset until configured.
# Do not place wallet private keys or seed phrases here.
SOLANA_RPC_URL=

# Client-visible cluster selection is only a UI hint, not a security boundary.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
