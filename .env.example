# Local SQLite URL used by Prisma CLI and local development.
# This SQLite URL is for local development only. The current Prisma client
# is NOT connected to Turso; setting Turso variables below does not enable it.
DATABASE_URL=file:./dev.db

# Hosted Turso/libSQL credentials (adapter integration is still pending).
# Keep TURSO_AUTH_TOKEN secret.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Production is the default. Use simulation ONLY for an explicitly labelled demo.
# Real transactions remain disabled until the Solana/Pump.fun adapter is implemented.
AHE_MARKET_MODE=mainnet

# Server-side Solana RPC endpoint. Leave unset until configured.
# Do not place wallet private keys or seed phrases here.
SOLANA_RPC_URL=

# Client-visible cluster selection is only a UI hint, not a security boundary.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
